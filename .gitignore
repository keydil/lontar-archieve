# 3D model files — too large for GitHub (use Git LFS or host separately)
# Keep only the ones explicitly listed below; block all others by default
public/models/*.glb
# allow these specific models that are small enough:
!public/models/sepatu-koku.glb

# 3D model textures (hasil RealityScan, u0_v0_*.png) — sama gedenya
# kayak model .glb-nya, jangan ikut ke-commit. Cukup ada di lokal /
# server produksi saja.
public/models/*.png
public/models/*.jpg
