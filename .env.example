# Salin file ini jadi `.env` dan isi nilai aslinya di sana.
# `.env` sudah di-gitignore — JANGAN pernah commit kredensial asli.

# ── Supabase — Dashboard -> Project Settings -> API ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Cloudflare R2 (upload model 3D .glb) ──
# Lihat public/models/README.md buat langkah lengkap bikin bucket + token.
# STORAGE_ENDPOINT = endpoint API S3-compatible, buat autentikasi upload.
#   Format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# STORAGE_PUBLIC_URL = URL BEDA buat baca publik (bukan endpoint di atas).
#   Aktifkan di bucket -> Settings -> Public access -> Allow Access,
#   formatnya: https://pub-xxxxxxxx.r2.dev
STORAGE_KEY_ID=
STORAGE_SECRET_KEY=
STORAGE_BUCKET_NAME=museum-talaga-assets
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_PUBLIC_URL=

# ── HANYA buat script migrasi sekali-jalan (scripts/migrate-models-to-storage.mjs) ──
# Dashboard Supabase -> Project Settings -> API -> service_role secret.
# JANGAN PERNAH dipakai di kode client-side/browser, dan JANGAN commit.
SUPABASE_SERVICE_ROLE_KEY=
